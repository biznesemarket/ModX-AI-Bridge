{
  "name": "modx-ai-bridge/modx-ai-bridge",
  "description": "AI Control Layer for MODX 3",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "xpdo/xpdo": "^3.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "AIBridge\\": "core/components/aibridge/src/",
      "AIBridge\\SDK\\": "sdk/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AIBridge\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find core/components/aibridge/src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "build-schema": "php scripts/generate-schema.php",
    "integration:preflight": "php tests/Integration/preflight.php",
    "verify-generated-model": "php scripts/verify-generated-model.php",
    "build-release": [
      "@build-schema",
      "@verify-generated-model",
      "@verify-static-contract",
      "php _build/build.php"
    ],
    "verify-static-contract": "php tests/Integration/static-contract.php",
    "test-modx": "bash scripts/test-modx.sh"
  },
  "config": {
    "sort-packages": true
  }
}
